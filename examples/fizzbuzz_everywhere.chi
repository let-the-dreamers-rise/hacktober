# FizzBuzz six times, in six languages, in one file.

def fizz_python(n):
    return "FizzBuzz" if n % 15 == 0 else "Fizz" if n % 3 == 0 else "Buzz" if n % 5 == 0 else str(n)

function fizzJs(n) {
  if (n % 15 === 0) return "FizzBuzz";
  if (n % 3 === 0) return "Fizz";
  if (n % 5 === 0) return "Buzz";
  return String(n);
}

def fizz_ruby(n)
  case
  when n % 15 == 0 then "FizzBuzz"
  when n % 3 == 0 then "Fizz"
  when n % 5 == 0 then "Buzz"
  else n.to_s
  end
end

fn fizz_rust(n: i64) -> String {
    match (n % 3, n % 5) {
        (0, 0) => "FizzBuzz".to_string(),
        (0, _) => "Fizz".to_string(),
        (_, 0) => "Buzz".to_string(),
        _ => n.to_string(),
    }
}

local function fizz_lua(n)
  if n % 15 == 0 then return "FizzBuzz"
  elseif n % 3 == 0 then return "Fizz"
  elseif n % 5 == 0 then return "Buzz"
  else return tostring(n) end
end

fizzHaskell n
  | n `mod` 15 == 0 = "FizzBuzz"
  | n `mod` 3 == 0 = "Fizz"
  | n `mod` 5 == 0 = "Buzz"
  | otherwise = show n

implementations = [fizz_python, fizzJs, fizz_ruby, fizz_rust, fizz_lua, fizzHaskell]
for f in implementations:
    print(" ".join(f(n) for n in range(1, 16)))

# They all agree:
results = [[f(n) for n in range(1, 101)] for f in implementations]
print("all agree:", all(r == results[0] for r in results))
