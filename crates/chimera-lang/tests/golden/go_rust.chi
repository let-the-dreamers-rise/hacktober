// Go and Rust
package main

import (
    "fmt"
    "strings"
)

type Rectangle struct {
    Width, Height float64
}

func (r Rectangle) Area() float64 {
    return r.Width * r.Height
}

func divmod(a, b int) (int, int) {
    return a / b, a % b
}

func sumAll(nums ...int) int {
    total := 0
    for _, n := range nums {
        total += n
    }
    return total
}

func main() {
    r := Rectangle{Width: 3, Height: 4.5}
    fmt.Println("area:", r.Area())
    q, rem := divmod(17, 5)
    fmt.Printf("17 = 5*%d + %d\n", q, rem)
    fmt.Println(sumAll(1, 2, 3, 4, 5))
    words := []string{"go", "is", "fun"}
    fmt.Println(strings.Join(words, "-"), len(words))
    m := map[string]int{"a": 1, "b": 2}
    m["c"] = 3
    if v, ok := m["b"]; ok {
        fmt.Println("found b =", v)
    }
    for i := 0; i < 3; i++ {
        defer fmt.Println("deferred", i)
    }
    squares := make([]int, 0)
    for i := range 5 {
        squares = append(squares, i*i)
    }
    fmt.Println(squares, strings.ToUpper("shout"), strings.Contains("haystack", "st"))
}

main()

// ---- Rust ----
#[derive(Debug, Clone, PartialEq)]
enum Shape {
    Circle(f64),
    Rect { w: f64, h: f64 },
    Unit,
}

impl Shape {
    fn area(&self) -> f64 {
        match self {
            Shape::Circle(r) => 3.14159 * r * r,
            Shape::Rect { w, h } => w * h,
            Shape::Unit => 0.0,
        }
    }
}

fn describe(n: i32) -> &'static str {
    match n {
        0 => "zero",
        1..=9 => "small",
        x if x < 0 => "negative",
        _ => "large",
    }
}

fn find_even(xs: &[i32]) -> Option<i32> {
    for &x in xs {
        if x % 2 == 0 {
            return Some(x);
        }
    }
    None
}

fn parse_num(s: &str) -> Result<i32, String> {
    match s.parse::<i32>() {
        Ok(n) => Ok(n),
        Err(_) => Err(format!("not a number: {}", s)),
    }
}

fn main_rs() {
    let shapes = vec![Shape::Circle(1.0), Shape::Rect { w: 2.0, h: 3.0 }, Shape::Unit];
    for s in &shapes {
        println!("{:?} has area {:.2}", s, s.area());
    }
    let mut total = 0;
    for n in [-5, 0, 7, 42] {
        println!("{} is {}", n, describe(n));
        total += n;
    }
    println!("total = {total}");
    let evens: Vec<i32> = (1..=10).filter(|x| x % 2 == 0).map(|x| x * x).collect();
    println!("{:?}", evens);
    match find_even(&[1, 3, 8, 5]) {
        Some(x) => println!("first even: {}", x),
        None => println!("no evens"),
    }
    if let Some(x) = find_even(&[1, 3]) {
        println!("unexpected {}", x);
    } else {
        println!("none found");
    }
    println!("{:?} {:?}", parse_num("42"), parse_num("4x2"));
    let doubled = parse_num("21").map(|n| n * 2).unwrap_or(0);
    println!("doubled = {}", doubled);
    let name = String::from("Ferris");
    let greeting = format!("Hello, {}! You are {} chars long.", name, name.len());
    println!("{}", greeting);
    let mut v = Vec::new();
    v.push(3);
    v.push(1);
    v.push(2);
    v.sort();
    println!("{:?} len={} contains 2: {}", v, v.len(), v.contains(&2));
    let sum: i32 = v.iter().sum();
    let max = v.iter().max().unwrap();
    println!("sum={} max={}", sum, max);
    let closure = |a: i32, b: i32| -> i32 { a * b };
    println!("{}", closure(6, 7));
}

main_rs();

fn parse_all(items: Vec<&str>) -> Result<Vec<i64>, String> {
    let mut out = Vec::new();
    for s in items {
        out.push(s.parse::<i64>()?);
    }
    Ok(out)
}
println!("{:?}", parse_all(vec!["1", "2", "3"]));
match parse_all(vec!["4", "five"]) {
    Ok(v) => println!("parsed {:?}", v),
    Err(e) => println!("error: {}", e),
}
