# Python-flavoured Chimera
from math import sqrt, pi
import json

def greet(name, greeting="Hello"):
    return f"{greeting}, {name}!"

print(greet("Ada"))
print(greet("Grace", greeting="Hi"))

squares = [x * x for x in range(10) if x % 2 == 0]
print(squares)
print({k: v for k, v in zip("abc", [1, 2, 3])})
print({n % 3 for n in range(10)})

class Animal:
    count = 0

    def __init__(self, name, sound):
        self.name = name
        self.sound = sound
        Animal.count += 1

    def speak(self):
        return f"{self.name} says {self.sound}"

    def __repr__(self):
        return f"Animal({self.name!r})"

class Dog(Animal):
    def __init__(self, name):
        super().__init__(name, "woof")

    def speak(self):
        return super().speak().upper()

pets = [Animal("Cat", "meow"), Dog("Rex")]
for p in pets:
    print(p.speak())
print(pets, Animal.count)

def stats(*nums, **opts):
    total = sum(nums)
    if opts.get("mean"):
        return total / len(nums)
    return total

print(stats(1, 2, 3, 4), stats(1, 2, 3, 4, mean=True))

words = "the quick brown fox jumps over the lazy dog".split()
print(sorted(words, key=len)[-3:], words[::-1][:2])
print(" ".join(w.capitalize() for w in words[:3]))
counts = {}
for w in words:
    counts[w] = counts.get(w, 0) + 1
print(max(counts, key=counts.get), counts["the"])

try:
    1 / 0
except ZeroDivisionError as e:
    print("caught:", e)
finally:
    print("finally ran")

def fib():
    a, b = 0, 1
    while True:
        yield a
        a, b = b, a + b

gen = fib()
print([next(gen) for _ in range(10)])

lam = lambda x, y=10: x + y
print(lam(1), lam(1, 2), list(map(lambda s: s[::-1], ["abc", "xyz"])))
print(f"{pi:.3f} {sqrt(2):.4f} {255:x} {1234567:,} {'pad':>6}|")
print(json.dumps({"a": [1, 2, None], "b": True}))
data = json.loads('{"x": 1.5, "y": [true, null]}')
print(data["x"], data["y"])
a, *rest = [1, 2, 3, 4]
print(a, rest)
print(isinstance(3, int), type("s").__name__, len({"a": 1}))
print(any(x > 3 for x in [1, 5]), all([]), divmod(17, 5), abs(-3), round(2.675, 2))
x = 5
print("big" if x > 3 else "small")
print([i for i, ch in enumerate("hello") if ch == "l"])
matrix = [[1, 2], [3, 4]]
print([row[i] for row in matrix for i in range(2)], list(zip(*matrix)))
with open("/tmp/chimera_golden_test.txt", "w") as f:
    f.write("line one\nline two\n")
with open("/tmp/chimera_golden_test.txt") as f:
    print([line.strip() for line in f])
