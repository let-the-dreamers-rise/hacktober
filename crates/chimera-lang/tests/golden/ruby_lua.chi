# Ruby
class Stack
  attr_reader :items

  def initialize
    @items = []
  end

  def push(x)
    @items.push(x)
    self
  end

  def pop
    @items.pop
  end

  def empty?
    @items.empty?
  end

  def each
    @items.each { |x| yield x }
  end

  def to_s
    "Stack(#{@items.join(', ')})"
  end
end

s = Stack.new
s.push(1).push(2).push(3)
puts s
puts s.pop
puts s.empty?
s.each { |x| puts "item #{x}" }

[1, 2, 3].each_with_index do |x, i|
  puts "#{i}: #{x * 10}"
end

squares = (1..5).map { |n| n ** 2 }
puts squares.inspect
puts squares.select(&:even?).inspect
puts squares.reduce(:+)
puts (1..10).step(3).to_a.inspect
evens, odds = (1..6).partition { |n| n.even? }
puts "#{evens} #{odds}"

def greet(name = "world")
  return "hi #{name}" unless name.empty?
  "nobody"
end
puts greet
puts greet("Matz")

total = 0
5.times { |i| total += i }
puts "total #{total}"
x = 7
puts "odd" if x.odd?
case x
when 1..5 then puts "low"
when 6..10 then puts "high"
else puts "off scale"
end
h = { name: "Ruby", year: 1995 }
h.each { |k, v| puts "#{k} => #{v}" }
puts h[:name]
puts %w[apple banana cherry].map(&:upcase).join(" ")
def twice
  yield
  yield
end
twice { puts "yo" }
begin
  raise ArgumentError, "bad input"
rescue ArgumentError => e
  puts "rescued: #{e.message}"
ensure
  puts "ensure ran"
end

-- Lua
local function fib(n)
  if n < 2 then
    return n
  end
  return fib(n - 1) + fib(n - 2)
end

local t = {}
for i = 1, 10 do
  t[#t + 1] = fib(i)
end
print(table.concat(t, ", "))

local person = { name = "Lua", born = 1993 }
for k, v in pairs(person) do
  print(k .. " = " .. tostring(v))
end
for i, v in ipairs({ "a", "b", "c" }) do
  io.write(i, ":", v, " ")
end
print()
local count = 0
while count < 3 do
  count = count + 1
end
repeat
  count = count - 1
until count == 0
print("count is " .. count, #"hello", 10 // 3, 2 ^ 8)
local s2 = string.format("%s has %d letters", "chimera", string.len("chimera"))
print(s2, string.upper("lua"), ("x"):rep(3))
local t = {10, 20, 30}
for i, v in ipairs(t) do io.write(i, "=", v, " ") end
print("#t = " .. #t)
