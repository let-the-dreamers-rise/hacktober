-- Haskell
factorial :: Integer -> Integer
factorial 0 = 1
factorial n = n * factorial (n - 1)

fib :: Int -> Int
fib n
  | n < 2 = n
  | otherwise = fib (n - 1) + fib (n - 2)

quicksort [] = []
quicksort (p:xs) = quicksort [x | x <- xs, x < p] ++ [p] ++ quicksort [x | x <- xs, x >= p]

main = do
  print (factorial 25)
  print (map fib [0..10])
  print (quicksort [3, 1, 4, 1, 5, 9, 2, 6])
  print $ sum $ filter even $ map (* 3) [1..10]
  let squares = [x * x | x <- [1..5]]
  print squares
  print (foldr (\x acc -> x + acc) 0 [1, 2, 3])
  putStrLn (show (length "haskell") ++ " letters")

(* OCaml *)
let rec sum_list lst =
  match lst with
  | [] -> 0
  | head :: tail -> head + sum_list tail

let square x = x * x
let () = Printf.printf "sum = %d, square = %d\n" (sum_list [1; 2; 3; 4]) (square 12)
let compose f g x = f (g x)
let add_one = fun x -> x + 1
let () = print_endline (string_of_int (compose square add_one 4))

// Kotlin
data class User(val name: String, val age: Int)

fun describe(x: Any): String = when (x) {
    is Int -> "int $x"
    is String -> "string of length ${x.length}"
    else -> "something else"
}

fun kotlinMain() {
    val users = listOf(User("ann", 31), User("bob", 17), User("cy", 45))
    val adults = users.filter { it.age >= 18 }.map { it.name.uppercase() }
    println(adults)
    println(describe(42))
    println(describe("hello"))
    println(describe(3.5))
    val total = users.sumOf { it.age }
    println("total age: $total")
    for (i in 1..3) print("$i ")
    println()
    val maybe: String? = null
    println(maybe?.length ?: -1)
    val oldest = users.maxByOrNull { it.age }
    println(oldest?.name)
}

// Swift
func greet(person: String, from hometown: String) -> String {
    return "Hello \(person)! Glad you could visit from \(hometown)."
}

struct Counter {
    var count = 0
    mutating func increment(by amount: Int = 1) {
        count += amount
    }
}

func swiftMain() {
    print(greet(person: "Bill", from: "Cupertino"))
    var counter = Counter()
    counter.increment()
    counter.increment(by: 5)
    print("count: \(counter.count)")
    let numbers = [3, 7, 1]
    let sorted = numbers.sorted()
    print(sorted, numbers.count)
    for i in 0..<3 {
        print(i, terminator: " ")
    }
    print("")
    guard let first = numbers.first else { return }
    print("first: \(first)")
    if let idx = numbers.firstIndex(of: 7) {
        print("7 at \(idx)")
    }
}

kotlinMain()
swiftMain()
// Haskell's `main` runs automatically at the end.

val ages = mapOf("ann" to 31, "bob" to 27)
println(ages)
println((10 downTo 0 step 5).toList())
